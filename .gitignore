# === Python ignores ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.db
*.sqlite3

# Virtual environment folders
venv/
env/
.venv/
.venv-*/
.env/
ENV/
*.env
.env
.env.*
!.env.example

# Logs
*.log
logs/*
!logs/.gitkeep

# IDE settings
.idea/
.vscode/

# Local agent and cloud configuration
.agents/
.codex/
.aws/

# OS files
.DS_Store
Thumbs.db

# Secret / private keys
*secret*.json
*key*.json

# Deployment / containers
*.pid
*.sock
*.crt
*.pem

# Coverage / test artifacts
*.coverage
htmlcov/

# Cache folders
.cache/
.ruff_cache/
dist/
build/
.pytest_cache/
*.egg-info/

# Generated model weights and training output
checkpoints/
outputs/
runs/
wandb/
*.safetensors
*.pt
*.pth
*.ckpt

# Docker-related
docker-compose.override.yml

# Generated baseline reports and downloaded datasets
results/
data/raw/
data/processed/

# Historical benchmark artifacts (keep the source evaluation dataset trackable)
/data/jev_results.zip
/data/jev_results/

# Local annotation state, SQLite sidecars, and unreviewed source caches
/data/annotation/
/data/exports/
# Unreviewed expansion stays local until an explicit dataset publication decision.
/data/milestone700_v1/
/data/validation200_v1/
*.sqlite3-wal
*.sqlite3-shm

# Independent test candidate workspace stays local until review and dataset freeze.
/data/test400_v1/
data/*
# Local publication candidates and review evidence; upload only via guarded publisher.
/artifacts/huggingface/
/artifacts/huggingface-review/

# Public adapter caches are generated locally; only reviewed evidence is tracked.
.hf-cache/
# docs/benchmarks/allowlist.json enumerates the public benchmark copies explicitly.
# Cleanup integrity receipts name private original artifacts; keep them local.
/artifacts/repository-cleanup/
